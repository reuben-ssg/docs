{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reuben-docs",
  "compatibility_date": "2025-10-03",
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "preview_urls": true,
  // Worker Previews (`npx wrangler preview`, run for non-main branches) need this
  // block to exist; the site has no bindings, so it stays empty.
  "previews": {},
}
